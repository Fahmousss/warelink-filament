@startuml Master Data Management

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Mengelola Master Data (Admin Gudang)

|Admin Gudang|
start
:Akses menu Master Data;
:Pilih jenis data;

if (Jenis data?) then (Pengguna)
  :Pilih aksi CRUD;
  :Input/Update data pengguna;

  |System|
  :Validasi data;
  :Proses data pengguna;
  :Simpan ke database;

  |Admin Gudang|
  :Tampilkan hasil operasi;

elseif (Jenis data?) then (Supplier)
  :Pilih aksi CRUD;
  :Input/Update data supplier;

  |System|
  :Generate kode supplier (jika baru);
  :Validasi data;
  :Simpan ke database;

  |Admin Gudang|
  :Tampilkan hasil operasi;

elseif (Jenis data?) then (Produk)
  :Pilih aksi CRUD;
  :Input/Update data produk;

  |System|
  :Generate kode produk (jika baru);
  :Validasi data;
  :Catat pergerakan stok (jika ada perubahan);
  :Simpan ke database;

  |Admin Gudang|
  :Tampilkan hasil operasi;

else (Batal)
  :Kembali ke menu;
endif

stop

@enduml
