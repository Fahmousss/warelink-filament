@startuml Monthly Report Generation

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Membuat Laporan Bulanan (Accounting)

|Accounting|
start
:Akses menu Laporan;
:Pilih periode (bulan/tahun);
:Pilih jenis laporan;

if (Jenis laporan?) then (Purchase Order)
  |System|
  :Query data PO berdasarkan periode;
  :Hitung statistik dan metrik;
  :Generate grafik dan chart;

  |Accounting|
  :Tampilkan laporan PO;

elseif (Jenis laporan?) then (Penerimaan Barang)
  |System|
  :Query data GR berdasarkan periode;
  :Hitung acceptance rate dan metrik;
  :Generate grafik performa supplier;

  |Accounting|
  :Tampilkan laporan GR;

elseif (Jenis laporan?) then (Stok Produk)
  |System|
  :Query data produk dan pergerakan stok;
  :Hitung stok rendah dan projected stock;
  :Generate grafik distribusi stok;

  |Accounting|
  :Tampilkan laporan Stok;

elseif (Jenis laporan?) then (Keuangan)
  |System|
  :Query data PO dan GR (Completed);
  :Hitung total pengeluaran dan outstanding;
  :Generate grafik spending trend;

  |Accounting|
  :Tampilkan laporan Keuangan;

else (Batal)
  :Kembali ke menu;
  stop
endif

if (Perlu export?) then (Ya)
  :Pilih format (PDF/Excel/CSV);

  |System|
  :Generate dan download file;

  |Accounting|
  :Simpan file laporan;
else (Tidak)
  :Tutup laporan;
endif

stop

@enduml
