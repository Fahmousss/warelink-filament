@startuml Purchase Order Management

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Manajemen Purchase Order (Admin Gudang)

|Admin Gudang|
start
:Akses menu Purchase Order;
:Pilih aksi;

if (Aksi?) then (Buat PO)
  :Pilih supplier;
  :Input detail PO;
  :Input detail produk;

  |System|
  :Generate nomor PO;
  :Hitung total amount;
  :Set status = Pending;
  :Simpan Purchase Order;
  :Kirim notifikasi ke Supplier;

  |Admin Gudang|
  :Tampilkan hasil;

elseif (Aksi?) then (Edit PO)
  :Pilih Purchase Order;

  |System|
  :Periksa status PO;

  if (Status = Pending?) then (Ya)
    |Admin Gudang|
    :Update data PO;
    :Update detail produk;

    |System|
    :Hitung ulang total amount;
    :Simpan perubahan;

    |Admin Gudang|
    :Tampilkan hasil;
  else (Tidak)
    |Admin Gudang|
    :Tampilkan error "PO tidak dapat diubah";
  endif

elseif (Aksi?) then (Lihat PO)
  |System|
  :Tampilkan daftar Purchase Order;
  :Tampilkan detail PO (jika dipilih);

  |Admin Gudang|
  :Lihat detail;

elseif (Aksi?) then (Batalkan PO)
  :Pilih Purchase Order;

  |System|
  :Periksa status PO;

  if (Status = Pending?) then (Ya)
    :Set status = Cancelled;
    :Simpan perubahan;
    :Kirim notifikasi ke Supplier;

    |Admin Gudang|
    :Tampilkan hasil;
  else (Tidak)
    |Admin Gudang|
    :Tampilkan error "PO tidak dapat dibatalkan";
  endif

else (Batal)
  :Kembali ke menu;
endif

stop

@enduml
