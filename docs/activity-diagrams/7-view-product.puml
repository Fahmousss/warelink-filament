@startuml View Product

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Melihat Produk (Supplier)

|Supplier|
start
:Akses menu Produk;

|System|
:Tampilkan daftar produk supplier;

|Supplier|
:Pilih aksi;

if (Aksi?) then (Filter/Cari)
  :Input kriteria filter;

  |System|
  :Filter produk berdasarkan kriteria;
  :Tampilkan hasil filter;

  |Supplier|
  :Lihat hasil;

elseif (Aksi?) then (Lihat Detail)
  :Pilih produk;

  |System|
  :Tampilkan detail produk;
  :Tampilkan informasi stok;
  :Tampilkan statistik produk;
  :Tampilkan riwayat transaksi;

  |Supplier|
  if (Lihat riwayat stok?) then (Ya)
    |System|
    :Tampilkan riwayat pergerakan stok;
    |Supplier|
  endif

  if (Lihat grafik trend?) then (Ya)
    |System|
    :Generate dan tampilkan grafik trend;
    |Supplier|
  endif

  :Selesai melihat detail;

elseif (Aksi?) then (Export Data)
  :Pilih produk dan format;

  |System|
  :Generate dan download file;

  |Supplier|
  :Download selesai;

else (Batal)
  :Kembali ke menu;
endif

stop

@enduml
