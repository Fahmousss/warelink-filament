@startuml Messaging

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Mengirim Pesan (All Users)

|User|
start
:Akses menu Chat/Pesan;

|System|
:Tampilkan daftar chat (jika ada);

|User|
:Pilih aksi;

if (Aksi?) then (Buat Chat Baru)
  :Pilih jenis chat;

  if (Jenis chat?) then (Private)
    :Pilih user tujuan;

    |System|
    :Validasi akses chat;
    :Buat atau buka chat existing;

    |User|
    :Chat siap;

  elseif (Jenis chat?) then (Group)
    |User|
    :Input nama group;
    :Pilih anggota (min 2);

    |System|
    :Validasi dan buat group chat;
    :Set admin group;
    :Kirim notifikasi ke anggota;

    |User|
    :Chat siap;
  endif

elseif (Aksi?) then (Buka Chat)
  :Pilih chat;

  |System|
  :Tampilkan riwayat pesan;
  :Mark pesan sebagai read;

  |User|
  :Chat siap;

else (Batal)
  :Kembali ke daftar chat;
  stop
endif

:Tulis dan kirim pesan;

|System|
:Validasi pesan;
:Simpan pesan ke database;
:Broadcast via Reverb/WebSocket;
:Kirim notifikasi ke recipient;

note right
  Recipient akan menerima pesan:
  - Real-time jika chat terbuka
  - Notifikasi jika chat tertutup
  - Increment unread counter
end note

|User|
:Tampilkan pesan terkirim;

stop

@enduml
