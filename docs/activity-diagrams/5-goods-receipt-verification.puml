@startuml Goods Receipt Verification

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Memverifikasi & Menyelesaikan Penerimaan Barang (Admin Gudang)

|Admin Gudang|
start
:Terima notifikasi Goods Receipt;
:Akses menu Goods Receipt;

|System|
:Tampilkan daftar GR (Pending);

|Admin Gudang|
:Pilih Goods Receipt;
:Verifikasi data dengan dokumen POD;

if (Data sesuai?) then (Ya)
  :Klik "Verifikasi Penerimaan";

  |System|
  :Set status = Verified;
  :Simpan perubahan;

  |Admin Gudang|
  if (Selesaikan penerimaan?) then (Ya)
    :Klik "Selesaikan Penerimaan";
    :Konfirmasi penyelesaian;

    |System|
    :Set status = Completed;
    :Update stok produk;
    :Catat pergerakan stok;
    :Update status PO (Partial/Completed);
    :Update status Shipment = Processed;
    :Kirim notifikasi ke Accounting;
    :Kirim notifikasi ke Supplier (jika ada produk ditolak);

    |Admin Gudang|
    :Tampilkan hasil;
  else (Tidak)
    :Kembali ke daftar GR;
  endif
else (Tidak)
  :Identifikasi masalah;
  :Kembalikan ke Checker atau hubungi Supplier;

  |System|
  :Status tetap Pending;
  :Kirim notifikasi ke pihak terkait;

  |Admin Gudang|
endif

stop

@enduml
