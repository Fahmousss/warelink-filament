@startuml Goods Receipt Creation

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Membuat Penerimaan Barang (Checker)

|Checker|
start
:Terima notifikasi DO (Shipped);
:Akses menu Delivery Order;

|System|
:Tampilkan daftar DO (Shipped);

|Checker|
:Pilih Delivery Order;
:Verifikasi dokumen DO;

if (Dokumen sesuai?) then (Ya)
  :Klik "Buat Penerimaan Barang";
  :Periksa kondisi fisik barang;
  :Input jumlah diterima dan ditolak;
  :Input alasan penolakan (jika ada);
  :Upload dokumen POD;

  |System|
  :Generate nomor GRN;
  :Set status = Pending;
  :Set received_by = Checker;
  :Simpan Goods Receipt;
  :Update status shipment = Arrived;
  :Kirim notifikasi ke Admin Gudang;

  |Checker|
  :Tampilkan hasil;
else (Tidak)
  :Tampilkan error "Dokumen tidak sesuai";
  :Hubungi supplier;
endif

stop

@enduml
