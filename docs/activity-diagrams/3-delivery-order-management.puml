@startuml Delivery Order Management

skinparam defaultFontName Times New Roman
skinparam activityFontName Times New Roman
skinparam activityArrowFontName Times New Roman
skinparam partitionFontName Times New Roman
skinparam swimlane {
  BorderColor #444444
  TitleBackgroundColor #EEEEEE
}
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontColor #000000
}
skinparam arrow {
  Color #A80036
  FontColor #000000
}
skinparam note {
  BackgroundColor #FBFB77
  BorderColor #A80036
}

title Activity Diagram - Mengelola Delivery Order (Supplier)

|Supplier|
start
:Akses menu Purchase Order;

|System|
:Tampilkan daftar PO supplier;

|Supplier|
:Pilih aksi;

if (Aksi?) then (Buat DO)
  :Pilih Purchase Order;
  :Input detail DO;
  :Input detail produk yang dikirim;
  :Upload dokumen DO;

  |System|
  :Generate nomor shipment;
  :Validasi jumlah produk;
  :Set status = Draft;
  :Simpan Shipment;

  |Supplier|
  :Tampilkan hasil;

elseif (Aksi?) then (Edit DO)
  :Pilih Shipment;

  |System|
  :Periksa status Shipment;

  if (Status = Draft?) then (Ya)
    |Supplier|
    :Update data DO;
    :Update detail produk;

    |System|
    :Validasi dan simpan;

    |Supplier|
    :Tampilkan hasil;
  else (Tidak)
    |Supplier|
    :Tampilkan error "DO tidak dapat diubah";
  endif

elseif (Aksi?) then (Lihat DO)
  |System|
  :Tampilkan daftar Shipment;
  :Tampilkan detail DO (jika dipilih);

  |Supplier|
  :Lihat detail;

elseif (Aksi?) then (Kirim Barang)
  :Pilih Shipment (Draft);
  :Konfirmasi pengiriman;

  |System|
  :Set status = Shipped;
  :Simpan perubahan;
  :Kirim notifikasi ke Admin Gudang dan Checker;

  |Supplier|
  :Tampilkan hasil;

else (Batal)
  :Kembali ke menu;
endif

stop

@enduml
