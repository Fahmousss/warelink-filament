@startuml Delivery Order Management

title Activity Diagram - Mengelola Delivery Order (Supplier)

|Supplier|
start
:Login ke sistem;
:Akses menu Purchase Order;

|System|
:Lihat daftar PO yang ditujukan\nke supplier sendiri;
:Filter PO berdasarkan status\n(Pending/Partial);

|Supplier|
:Pilih Purchase Order;

|System|
:Lihat detail PO:
- Nomor PO
- Tanggal order
- Estimasi pengiriman
- Detail produk yang dipesan
- Jumlah per produk
- Catatan;

|Supplier|
if (Ingin membuat Delivery Order?) then (Ya)
  :Klik tombol "Buat Delivery Order";

  |System|
  :Generate nomor shipment otomatis;

  |Supplier|
  :Input nomor Delivery Order;
  :Input tanggal pengiriman;
  :Input estimasi tanggal kedatangan;
  :Upload scan dokumen DO;
  :Tambah detail produk yang akan dikirim;

  repeat
    :Pilih produk dari PO;
    :Input jumlah yang dikirim;

    floating note right
      Jumlah yang dikirim dapat
      berbeda dengan jumlah PO
      (partial shipment allowed)
    end note

    |System|
    if (Jumlah valid?) then (Ya)
      :Tambahkan ke detail shipment;
    else (Tidak)
      |Supplier|
      :Tampilkan error\n"Jumlah melebihi yang dipesan";
      stop
    endif
  repeat while (Ada produk lain?) is (Ya)
  ->Tidak;

  |Supplier|
  :Input catatan pengiriman (opsional);

  |System|
  :Set status shipment = Draft;
  :Simpan Shipment;

  |Supplier|
  :Tampilkan notifikasi sukses;

elseif (Ingin melihat shipment?) then (Ya)
  :Klik tab "Delivery Orders";

  |System|
  :Tampilkan daftar shipment\nuntuk supplier;
  :Filter berdasarkan status\n(Draft/Shipped/Arrived/Processed);

  |Supplier|
  :Pilih shipment untuk detail;

  |System|
  :Tampilkan informasi shipment:
  - Nomor shipment
  - Nomor DO
  - Purchase Order terkait
  - Tanggal pengiriman
  - Estimasi kedatangan
  - Status
  - Detail produk
  - Dokumen DO scan;

else (Edit Shipment)
  :Pilih shipment yang akan diedit;

  |System|
  if (Status shipment?) then (Draft)
    |Supplier|
    :Update data shipment\n(nomor DO, tanggal, estimasi, dokumen);

    if (Edit detail produk?) then (Ya)
      repeat
        :Update jumlah yang dikirim;

        |System|
        if (Jumlah valid?) then (Ya)
          :Simpan perubahan detail;
        else (Tidak)
          |Supplier|
          :Tampilkan error validasi;
          stop
        endif
      repeat while (Ada perubahan lain?) is (Ya)
      ->Tidak;
    else (Tidak)
    endif

    |System|
    :Simpan perubahan;

    |Supplier|
    :Tampilkan notifikasi sukses;
  else (Shipped/Arrived/Processed)
    |Supplier|
    :Tampilkan pesan error\n"Shipment tidak dapat diubah";
    stop
  endif
endif

if (Siap mengirim barang?) then (Ya)
  :Pilih shipment dengan status Draft;
  :Konfirmasi pengiriman;

  if (Konfirmasi?) then (Ya)
    |System|
    :Ubah status shipment = Shipped;
    :Simpan perubahan;
    :Kirim notifikasi ke Admin Gudang\ndan Checker;

    |Supplier|
    :Tampilkan notifikasi sukses\n"Barang telah dikirim";
  else (Tidak)
    stop
  endif
else (Tidak)
endif

floating note right
  Status Shipment:
  - Draft: Shipment dibuat tapi belum dikirim
  - Shipped: Barang sudah dikirim supplier
  - Arrived: Barang sudah tiba di gudang
  - Processed: Penerimaan barang selesai
end note

stop

@enduml
